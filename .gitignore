# ============================================================================
# What must NOT go into git.
#
# Rule of thumb for this project: commit anything a grader needs to read
# (code, docs, metrics JSON, figures), ignore anything they can regenerate
# (datasets, model weights, caches).
# ============================================================================

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Datasets -------------------------------------------------------------
# EMNIST is ~1.4 GB uncompressed. It is downloadable and reproducible from
# the provenance record, so it never belongs in the repo.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
# Generated plates: 1,200 PNGs, regenerable via scripts/make_test_plates.py.
# The IMAGES stay out of git - but manifest.csv is committed, because it is
# the ground truth every reported accuracy number was measured against.
# Without it, tier_results.json cannot be audited by anyone.
data/generated/*
!data/generated/.gitkeep
!data/generated/manifest.csv
emnist_data/
*.csv
# ...but the plate manifest is evidence, so it overrides the blanket *.csv
# rule above. Order matters here: a later negation wins in .gitignore.
!data/generated/manifest.csv
*.zip
*.gz
*.idx*-ubyte

# --- Model weights --------------------------------------------------------
# Regenerated by running ML_FinalProject_Group_8.ipynb in Colab.
artifacts/models/*
!artifacts/models/.gitkeep
*.keras
*.h5
*.pth

# Exception: the two trained models ARE committed (~12 MB total) so that
# demo_app.py runs from a clean clone without retraining first. These
# negations must stay BELOW the *.keras rule above - in .gitignore the last
# matching rule wins. plate_cnn.classmap.json is deliberately still ignored:
# it is a leftover from a removed implementation and nothing reads it.
!artifacts/models/plate_cnn.keras
!artifacts/models/plate_mlp.keras

# --- KEEP these: they are evidence the grader reads -----------------------
# artifacts/metrics/*.json     -> measured numbers (§9 results summary)
# artifacts/figures/*.png      -> confusion matrix, split proportions
# artifacts/provenance/*.json  -> data provenance, acceptance records

# --- Test / tooling caches ------------------------------------------------
.pytest_cache/
.coverage
htmlcov/

# --- Notebook noise -------------------------------------------------------
.ipynb_checkpoints/

# --- Editors / OS ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
