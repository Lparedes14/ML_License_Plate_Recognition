# ============================================================================
# What must NOT go into git.
#
# Rule of thumb for this project: commit anything a grader needs to read
# (code, docs, metrics JSON, figures), ignore anything they can regenerate
# (datasets, model weights, caches).
# ============================================================================

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Datasets -------------------------------------------------------------
# EMNIST is ~1.4 GB uncompressed. It is downloadable and reproducible from
# the provenance record, so it never belongs in the repo.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/generated/*
!data/generated/.gitkeep
emnist_data/
*.csv
*.zip
*.gz
*.idx*-ubyte

# --- Model weights --------------------------------------------------------
# Regenerated by `python scripts/train.py`. Too large for git.
artifacts/models/*
!artifacts/models/.gitkeep
*.keras
*.h5
*.pth

# --- KEEP these: they are evidence the grader reads -----------------------
# artifacts/metrics/*.json     -> measured numbers (§9 results summary)
# artifacts/figures/*.png      -> confusion matrix, split proportions
# artifacts/provenance/*.json  -> data provenance, acceptance records

# --- Test / tooling caches ------------------------------------------------
.pytest_cache/
.coverage
htmlcov/

# --- Notebook noise -------------------------------------------------------
.ipynb_checkpoints/

# --- Editors / OS ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
